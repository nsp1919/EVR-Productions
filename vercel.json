{
  "installCommand": "cd EVR-Client-Concept && npm ci --include=dev",
  "buildCommand": "cd EVR-Client-Concept && npm run build",
  "outputDirectory": "EVR-Client-Concept",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/admin/invitation", "destination": "/invitation/editor.html" },
    { "source": "/invitation/editor", "destination": "/invitation/editor.html" },
    { "source": "/invitation", "destination": "/invitation/index.html" },
    { "source": "/invitation/:id([a-z0-9-]+)", "destination": "/api/invitations?id=:id" },
    { "source": "/quote", "destination": "/quote-maker.html" },
    { "source": "/quote-maker", "destination": "/quote-maker.html" },
    { "source": "/quotes/:id([a-f0-9]{48})", "destination": "/proposal.html?id=:id&view=quote" },
    { "source": "/proposals/:id([a-f0-9]{48})", "destination": "/proposal.html?id=:id&view=proposal" }
  ]
}
